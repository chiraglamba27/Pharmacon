# Backend Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env

PORT=3001
NODE_ENV=development

# Supabase — get from your project dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# CORS — frontend URL
CORS_ORIGIN=http://localhost:5173

# AI Demo Mode — set to "true" in development to test the review UI
# In production this MUST be "false" or unset
AI_DEMO_MODE=false
